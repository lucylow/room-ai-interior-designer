{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "src/security/**/*.ts",
    "src/ai/**/*.ts",
    "src/state/**/*.ts",
    "src/tests/**/*.ts",
    "src/demo/**/*.ts"
  ]
}
