{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "security:typecheck": "tsc -p tsconfig.security.json --noEmit",
    "security:test": "vitest run src/tests",
    "security:check": "pnpm run security:typecheck && pnpm run security:test",
    "visualization:typecheck": "tsc -p tsconfig.visualization.json --noEmit",
    "visualization:test": "vitest run src/tests/visualization",
    "visualization:check": "pnpm run visualization:typecheck && pnpm run visualization:test",
    "cad-bim:typecheck": "tsc -p tsconfig.cad-bim.json --pretty false",
    "generative-design:typecheck": "tsc -p tsconfig.generative-design.json --pretty false",
    "retail-shopping:typecheck": "tsc -p tsconfig.retail-shopping.json --pretty false",
    "gaussian-splatting-v13:typecheck": "tsc -p tsconfig.gaussian-splatting-v13.json --pretty false",
    "gaussian-splatting-v13:test": "vitest run src/tests/gaussian-splatting-v13",
    "gaussian-splatting-v13:check": "pnpm run gaussian-splatting-v13:typecheck && pnpm run gaussian-splatting-v13:test",
    "computer-vision-dataset-v20:typecheck": "tsc -p computer-vision-dataset-v20/tsconfig.json --pretty false",
    "computer-vision-dataset-v20:test": "vitest run src/tests/computer-vision-dataset-v20.test.ts",
    "computer-vision-dataset-v20:check": "pnpm run computer-vision-dataset-v20:typecheck && pnpm run computer-vision-dataset-v20:test",
    "visual-ai-v14:typecheck": "tsc -p tsconfig.visual-ai-v14.json --pretty false",
    "visual-ai-v14:test": "vitest run src/tests/visual-ai-v14",
    "visual-ai-v14:check": "pnpm run visual-ai-v14:typecheck && pnpm run visual-ai-v14:test",
    "computer-vision-v22:typecheck": "tsc -p tsconfig.computer-vision-v22.json --pretty false",
    "computer-vision-v22:test": "vitest run src/tests/computer-vision-v22",
    "computer-vision-v22:check": "pnpm run computer-vision-v22:typecheck && pnpm run computer-vision-v22:test",
    "visual-ai:check": "pnpm run gaussian-splatting-v13:check && pnpm run visual-ai-v14:check",
    "commerce-v6:typecheck": "tsc -p tsconfig.commerce-v6.json --pretty false",
    "commerce-v6:test": "vitest run src/tests/commerce-v6",
    "commerce-v6:check": "pnpm run commerce-v6:typecheck && pnpm run commerce-v6:test && pnpm run lint:commerce-v6",
    "all-domain-check": "pnpm run visual-ai:check && pnpm run computer-vision-v22:check && pnpm run commerce-v6:check",
    "lint:commerce-v6": "eslint --config eslint.commerce-v6.config.mjs .",
    "monetization-v11:typecheck": "tsc -p tsconfig.apple-monetization-v11.json --pretty false",
    "monetization-v11:test": "vitest run src/tests/apple-monetization-v11.test.ts",
    "monetization-v11:check": "pnpm run monetization-v11:typecheck && pnpm run monetization-v11:test",
    "monetization-v13:typecheck": "tsc -p tsconfig.apple-monetization-v13.json --pretty false",
    "monetization-v13:test": "vitest run src/tests/apple-monetization-v13.*.test.ts",
    "monetization-v13:check": "pnpm run monetization-v13:typecheck && pnpm run monetization-v11:check && pnpm run monetization-v13:test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.5",
    "vitest": "^5.0.2"
  }
}
