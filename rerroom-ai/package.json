{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "security:typecheck": "tsc -p tsconfig.security.json --noEmit",
    "security:test": "vitest run src/tests",
    "security:check": "pnpm run security:typecheck && pnpm run security:test",
    "visualization:typecheck": "tsc -p tsconfig.visualization.json --noEmit",
    "visualization:test": "vitest run src/tests/visualization",
    "visualization:check": "pnpm run visualization:typecheck && pnpm run visualization:test",
    "cad-bim:typecheck": "tsc -p tsconfig.cad-bim.json --pretty false",
    "generative-design:typecheck": "tsc -p tsconfig.generative-design.json --pretty false",
    "retail-shopping:typecheck": "tsc -p tsconfig.retail-shopping.json --pretty false"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.5",
    "vitest": "^5.0.2"
  }
}
