{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "dist-generative-mock-v7",
    "noEmit": true,
    "types": []
  },
  "include": [
    "src/retail-shopping-v4/**/*.ts",
    "src/retail-shopping-v5/**/*.ts",
    "src/generative-mock-v7/**/*.ts",
    "services/generativeStudio.ts"
  ]
}
