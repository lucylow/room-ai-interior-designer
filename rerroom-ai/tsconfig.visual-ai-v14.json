{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/visual-ai-v14/**/*.ts",
    "src/state/domains/visual-ai-v14-store.ts",
    "src/tests/visual-ai-v14/**/*.ts"
  ]
}
