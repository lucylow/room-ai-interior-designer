{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server/retail-monetization-v6/src/**/*.ts",
    "server/retail-monetization-v6/server/**/*.ts",
    "src/state/domains/retail-commerce-v6-store.ts",
    "src/tests/commerce-v6/**/*.ts"
  ]
}
